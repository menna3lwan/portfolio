{
  "name": "menna-elwan-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/decode-pdf-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/decode-pdf-worker.mjs",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "build:preview": "VITE_ROUTER=hash npm run build",
    "build:pages": "VITE_BASE=${VITE_BASE:-/portfolio/} VITE_SITE_URL=${VITE_SITE_URL:-https://menna3lwan.github.io/portfolio} npm run build",
    "preview": "vite preview",
    "preview:pages": "VITE_BASE=${VITE_BASE:-/portfolio/} vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/decode-pdf-worker.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.2.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "description": "Menna Elwan — personal portfolio. React + TypeScript + Vite."
}
