# The deployment's own origin, with no trailing slash.
#
# Required for the real deploy: it is what canonical URLs, og:url, og:image and
# sitemap.xml are built from. When it is unset the build still succeeds, but those tags
# and the sitemap are omitted rather than pointed at a guessed domain.
#
# Set it in the hosting platform's build environment, not in a committed file.
VITE_SITE_URL=https://example.com

# Routing mode. Leave unset for the deployed site (real paths, indexable URLs).
# "hash" produces a build that runs from any directory, including straight off disk,
# for hosts that cannot rewrite unknown paths to the application.
# VITE_ROUTER=hash
